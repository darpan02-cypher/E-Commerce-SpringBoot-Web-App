<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="SPLUNK_HEC_URL" source="splunk.hec.url" />
    <springProperty scope="context" name="SPLUNK_HEC_TOKEN" source="splunk.hec.token" />
    <springProperty scope="context" name="SPLUNK_HEC_INDEX" source="splunk.hec.index" />
    <springProperty scope="context" name="SPLUNK_HEC_SOURCE" source="splunk.hec.source" />
    <springProperty scope="context" name="SPLUNK_HEC_SOURCETYPE" source="splunk.hec.sourcetype" />

    <property name="LOG_PATH" value="${LOG_PATH:-logs}" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventPatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <loggerName/>
                <threadName/>
                <logLevel/>
                <message/>
                <stackTrace/>
                <mdc/>
                <context/>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Reduce noise from framework libraries -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.hibernate" level="WARN" />

</configuration>
